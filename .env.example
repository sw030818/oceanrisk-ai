# Server only. Set securely in Vercel Environment Variables or ignored .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Text-based PDFs only. No document contents are persisted by the app.

# Required in production: a private random 32-256 character ASCII (A-Z/a-z/0-9/_/-) prototype access code.
# Set directly as a secure server env value in Vercel; not NEXT_PUBLIC_.
# This is local authentication, not a credential forwarded through an HTTPS proxy.
ANALYSIS_ACCESS_TOKEN=
