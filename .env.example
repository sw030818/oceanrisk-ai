# Active provider: server only (never NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Legacy Gemini settings retained, inactive; no automatic fallback.
# Server only. Set securely in Vercel Environment Variables or ignored .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Text-based PDFs only. No document contents are persisted by the app.

# Optional extra extraction: off until its real efficacy is established.
# One targeted request per document, no retry; only independently verified
# native PDF candidates can become effective fields. Server only.
SHIPPING_TARGETED_RECOVERY_ENABLED=false
