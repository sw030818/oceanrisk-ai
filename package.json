{
  "name": "oceanrisk-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:layouts": "tsx scripts/evaluate-layouts.ts",
    "test:layouts:production": "tsx scripts/live-layouts.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-openai.ts",
    "verify": "node scripts/verify.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "ship": "tsx scripts/ship.ts",
    "check:production": "tsx scripts/check-production.ts",
    "test:production": "tsx scripts/live-openai.ts",
    "build:verified": "node scripts/verify.mjs --build-only",
    "test:gemini:legacy": "tsx scripts/live-gemini.ts",
    "test:phase23:production": "tsx scripts/live-phase23.ts",
    "check:phase30:ui": "tsx scripts/check-phase30-ui.ts",
    "check:phase31:ui": "tsx scripts/check-phase31-ui.ts",
    "test:phase31:production": "tsx scripts/live-phase31.ts",
    "test:phase32:production": "tsx scripts/live-phase32.ts",
    "check:phase32:ui": "tsx scripts/check-phase32-ui.ts",
    "test:phase33:production": "tsx scripts/live-phase33.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
